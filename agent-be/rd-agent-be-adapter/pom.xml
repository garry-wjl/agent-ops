<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ink.garry.rd</groupId>
        <artifactId>rd-agent-be-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>rd-agent-be-adapter</artifactId>
    <name>rd-agent-be-adapter</name>
    <description>Adapter 层：HTTP Controller、SSE、过滤器、启动类</description>

    <properties>
        <!-- JDK17 模块封装：部分第三方库反射需开放 java.lang；值只写一处，
             本地(spring-boot:run)与容器入口各自引用。容器内堆/元空间/直接内存百分比见 docker/jvm-entrypoint.sh -->
        <jvm.addOpens>--add-opens=java.base/java.lang=ALL-UNNAMED</jvm.addOpens>
    </properties>

    <dependencies>
        <dependency>
            <groupId>ink.garry.rd</groupId>
            <artifactId>rd-agent-be-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- 与 rd-points-platform 一致：fat jar 固定为 app.jar，便于 Dockerfile / jib 路径稳定 -->
        <finalName>app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>ink.garry.rd.agent.ws.adapter.AgentBeApplication</mainClass>
                    <!-- 本地 spring-boot:run 的 JVM 参数 -->
                    <jvmArguments>${jvm.addOpens}</jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- jib：基础镜像见根 pom docker.from.image；仅 -Pdocker 时启用（根 pom dockerfile.skip） -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <skip>${dockerfile.skip}</skip>
                    <from>
                        <image>${docker.from.image}</image>
                    </from>
                    <to>
                        <image>${docker.image}</image>
                    </to>
                    <container>
                        <!-- JVM 内存百分比在 docker/jvm-entrypoint.sh，jib 的 jvmFlags 不会生效 -->
                        <entrypoint>
                            <arg>/app/jvm-entrypoint.sh</arg>
                        </entrypoint>
                        <workingDirectory>/app</workingDirectory>
                        <volumes>
                            <volume>/app/heapdump</volume>
                            <volume>/app/logs</volume>
                        </volumes>
                        <environment>
                            <TZ>Asia/Shanghai</TZ>
                        </environment>
                    </container>
                    <extraDirectories>
                        <paths>
                            <path>
                                <from>target</from>
                                <into>/app</into>
                                <includes>app.jar</includes>
                            </path>
                            <path>
                                <from>../docker</from>
                                <into>/app</into>
                                <includes>jvm-entrypoint.sh</includes>
                            </path>
                        </paths>
                        <permissions>
                            <permission>
                                <file>/app/jvm-entrypoint.sh</file>
                                <mode>755</mode>
                            </permission>
                        </permissions>
                    </extraDirectories>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <!-- dockerBuild：写入本地 Docker daemon，无需私有 Harbor -->
                            <goal>dockerBuild</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
