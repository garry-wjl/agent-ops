{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/",
    "build/",
    "*.min.js",
    "*.min.css",
    "node_modules/",
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    ".idea/",
    ".vscode/",
    "*~",
    ".DS_Store",
    ".cache/",
    ".output/",
    "coverage/",
    "env/",
    ".env",
    ".env.local",
    ".env.*.local",
    "*.local",
    "public/",
    ".husky/",
    "*.bak",
    "*.backup",
    "logs/",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "pnpm-debug.log*"
  ]
}
